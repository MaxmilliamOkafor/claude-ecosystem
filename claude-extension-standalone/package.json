{
  "name": "claude-extension-standalone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Claude browser extension \u2014 standalone. No monorepo, no backend, no required API key. Loads into Chrome directly.",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node test/run-unit.mjs",
    "test:e2e": "vite build && node test/workday-e2e/run.mjs",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
